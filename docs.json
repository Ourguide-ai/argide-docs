{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Argide",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://argide.ai"
  },
  "favicon": "/logo/favicon.png",
  "colors": {
    "primary": "#184F95",
    "light": "#6DA7EC",
    "dark": "#184F95"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "get-started/introduction",
              "get-started/quickstart"
            ]
          },
          {
            "group": "Set up",
            "pages": [
              "setup/embed-widget",
              "setup/user-identification",
              "setup/deploy"
            ]
          },
          {
            "group": "Configure your agent",
            "pages": [
              "agent/identity-instructions",
              "agent/mode-design",
              "agent/user-suggestions",
              "agent/page-navigation",
              "agent/workflows",
              "agent/in-page-actions",
              "agent/visibility"
            ]
          },
          {
            "group": "Knowledge base",
            "pages": [
              "knowledge-base/knowledge-base",
              "knowledge-base/website",
              "knowledge-base/files"
            ]
          },
          {
            "group": "Conversations",
            "pages": [
              "conversations/inbox",
              "conversations/escalation",
              "conversations/satisfaction",
              "conversations/email-notifications"
            ]
          },
          {
            "group": "Organization",
            "pages": [
              "organization/members"
            ]
          },
          {
            "group": "Agent SDK",
            "pages": [
              "agent-sdk/overview",
              "agent-sdk/installation",
              "agent-sdk/quickstart",
              "agent-sdk/claiming-sessions",
              "agent-sdk/running-tasks",
              "agent-sdk/api-reference"
            ]
          },
          {
            "group": "Optional",
            "pages": [
              {
                "group": "API integration",
                "pages": [
                  "integration/api-integration",
                  "integration/openapi",
                  "integration/openapi-auth",
                  "integration/identity-verification"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/setup/identity-verification",
      "destination": "/integration/identity-verification"
    },
    {
      "source": "/setup/flutter",
      "destination": "/setup/embed-widget"
    },
    {
      "source": "/setup/react-native",
      "destination": "/setup/embed-widget"
    },
    {
      "source": "/setup/customization",
      "destination": "/agent/mode-design"
    },
    {
      "source": "/setup/event-callbacks",
      "destination": "/setup/embed-widget"
    },
    {
      "source": "/setup/multi-language-support",
      "destination": "/agent/identity-instructions"
    },
    {
      "source": "/agent/actions",
      "destination": "/agent/in-page-actions"
    },
    {
      "source": "/agent/sandbox",
      "destination": "/get-started/quickstart"
    },
    {
      "source": "/monitor/activity",
      "destination": "/conversations/inbox"
    },
    {
      "source": "/knowledge-base/notion",
      "destination": "/knowledge-base/knowledge-base"
    },
    {
      "source": "/integration/integration",
      "destination": "/integration/api-integration"
    },
    {
      "source": "/integration/client-side-tools",
      "destination": "/integration/api-integration"
    },
    {
      "source": "/integration/tool-renderers",
      "destination": "/integration/api-integration"
    },
    {
      "source": "/integration/mcp-servers",
      "destination": "/integration/api-integration"
    },
    {
      "source": "/integration/external-mcp-servers",
      "destination": "/integration/api-integration"
    },
    {
      "source": "/integration/server-side-mcp-auth",
      "destination": "/integration/openapi-auth"
    },
    {
      "source": "/integration/multi-subdomain-endpoints",
      "destination": "/integration/openapi"
    },
    {
      "source": "/integration/envoy-cli",
      "destination": "/integration/api-integration"
    },
    {
      "source": "/get-started/ourguide-docs-mcp",
      "destination": "/get-started/introduction"
    }
  ],
  "footerSocials": {
    "x": "https://x.com/argide",
    "github": "https://github.com/Abhinav-2026",
    "linkedin": "https://www.linkedin.com/company/argide"
  },
  "background": {
    "color": {
      "light": "#FCFCFB",
      "dark": "#151515"
    }
  },
  "fonts": {
    "heading": {
      "family": "Source Serif 4",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@argide.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.argide.ai"
    }
  }
}
